# Скопируй в `.env` и поправь при необходимости; у всех значений есть default в docker-compose.yml.

# Postgres
DB_NAME=emotions
DB_USER=app_user
DB_PASSWORD=basic_app_password

# Kafka: число партиций всех топиков
TOPIC_PARTITIONS=1

# Значения по умолчанию сервисов; у сессий свои настройки в session-config.
# Модели лица: crema-swin-int8 | crema-swin | stub; голоса: crema-wavlm-int8 | crema-wavlm | stub
EMOTION_MODEL_DEFAULT=crema-swin-int8
VOICE_MODEL_DEFAULT=crema-wavlm-int8
TRACKER_DEFAULT=bytetrack
IDENTIFICATION_ENABLED=true

# Потоки ONNX Runtime
EMOTION_NUM_THREADS=2
VOICE_NUM_THREADS=2

# Детектор лиц: yunet | mediapipe; запуск раз в N кадров, между запусками рамки предсказывает трекер
DETECTOR_BACKEND=yunet
DETECTOR_MIN_CONF=0.6
DETECTOR_MAX_SIDE=480
DETECTION_FREQUENCY=2

# Эмоции лица: кадров в окне 3 с (8 | 16) и шаг окна
CLIP_FRAMES=8
EMOTION_HOP_MS=1000

# Реальное время: данные старше этого возраста не обрабатываются
MAX_FRAME_AGE_MS=1000
MAX_CHUNK_AGE_MS=2000

# Голос: окно и шаг анализа, порог VAD (доля речи в окне)
AUDIO_WINDOW_MS=3000
AUDIO_HOP_MS=1000
VAD_THRESHOLD=0.3

# Слияние: stack_hidden | stack_logits | weighted_logits | weighted_logits_robust |
# confidence_weighted | mean_probs | audio_only | video_only
FUSION_METHOD=stack_hidden
FUSION_VOICE_MAX_AGE_MS=3000
FUSION_MIN_OVERLAP_MS=1000
FUSION_DB_ENABLED=true

# Хранилище итоговых записей (SeaweedFS, S3 API на http://localhost:8333)
S3_ACCESS_KEY=affectra
S3_SECRET_KEY=affectra-secret
S3_BUCKET=affectra-recordings

# Архивация: ожидание слитой аналитики после конца сессии, предел длительности записи, потоки x264
ARCHIVE_ANALYTICS_GRACE_S=15
ARCHIVE_MAX_DURATION_S=1800
ARCHIVE_RENDER_THREADS=2
